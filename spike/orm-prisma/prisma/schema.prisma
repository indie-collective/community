generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model entity {
  id            String          @id @default(uuid())
  type          entity_type?
  /// #39: whether the organisation is still active.
  status        entity_status   @default(active)
  name          String
  about         String?
  location_id   String?        
  created_at    DateTime?       @default(now())
  updated_at    DateTime?       @updatedAt
  logo_id       String?        
  site          String?
  /// #161: the org's Bluesky handle, e.g. studio.bsky.social.
  bsky_handle   String?        
  lastModifiedById String?   
  location      location?       @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logo          image?          @relation(fields: [logo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entity_event  entity_event[]
  game_entity   game_entity[]

  @@index([location_id])
  @@index([logo_id])
  @@index([type])
}

model entity_event {
  entity_id  String   
  event_id   String   
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  entity     entity    @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event      event     @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([entity_id, event_id])
  @@index([event_id])
}



model event {
  id                String              @id @default(uuid())
  name              String
  about             String?
  location_id       String?            
  site              String?
  lastModifiedById  String?            
  starts_at         DateTime           
  ends_at           DateTime           
  created_at        DateTime?           @default(now())
  updated_at        DateTime?           @updatedAt
  cover_id          String?            
  status            event_status        @default(ongoing)
  /// IANA zone the event's times are shown and entered in (#204).
  time_zone         String              @default("Europe/Paris")
  cover             image?              @relation(fields: [cover_id], references: [id], onUpdate: NoAction)
  location          location?           @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entity_event      entity_event[]
  event_participant event_participant[]
  game_event        game_event[]

  @@index([location_id])
  @@index([cover_id])
  @@index([starts_at])
}

model event_participant {
  event_id  String   
  person_id String   
  joined_at DateTime? @default(now())
  event     event     @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  person    person    @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, person_id])
  @@index([person_id])
}

model game {
  id          String        @id @default(uuid())
  name        String
  about       String?
  site        String?
  created_at  DateTime?     @default(now())
  updated_at  DateTime?     @updatedAt
  igdb_slug   String?       @unique
  lastModifiedById String?
  game_entity game_entity[]
  game_event  game_event[]
  game_image  game_image[]
  game_tag    game_tag[]
  deleted     Boolean       @default(false)

  @@index([deleted])
}

model change {
  operation  operation_type
  id         String         @id @default(uuid())
  table_name String
  record_id  String        
  data       Json
  created_at DateTime?      @default(now())
  author_id  String?       
  author     person?        @relation(fields: [author_id], references: [id])

  @@index([table_name, record_id])
}


model game_entity {
  game_id    String   
  entity_id  String   
  /// #40: how the organisation took part in the game.
  role       game_entity_role @default(developer)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  entity     entity    @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  game       game      @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([game_id, entity_id])
  @@index([entity_id])
}

model game_event {
  game_id    String   
  event_id   String   
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  event      event     @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  game       game      @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([game_id, event_id])
  @@index([event_id])
}

model game_image {
  game_id    String   
  image_id   String   
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  game       game      @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  image      image     @relation(fields: [image_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([game_id, image_id])
  @@index([image_id])
}

model game_tag {
  game_id    String   
  tag_id     String   
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  game       game      @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag        tag       @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([game_id, tag_id])
  @@index([tag_id])
}

model image {
  id           String         @id @default(uuid())
  image_file   Json           @default("{}")
  created_at   DateTime?      @default(now())
  updated_at   DateTime?      @updatedAt
  entity       entity[]
  event        event[]
  game_image   game_image[]
  person       person[]
}

model location {
  id           String    @id @default(uuid())
  city         String?
  latitude     Float?
  longitude    Float?
  updated_at   DateTime? @updatedAt
  street       String?
  country_code String   
  region       String?
  entity       entity[]
  event        event[]

  @@unique([street, city, region, country_code, latitude, longitude])
  @@index([country_code])
}

model person {
  id                String              @id @default(uuid())
  first_name        String
  last_name         String?
  about             String?
  created_at        DateTime?           @default(now())
  updated_at        DateTime?           @updatedAt
  avatar_id         String?            
  discord_id        String?             @unique
  email             String?             @unique
  isAdmin           Boolean             @default(false)
  username          String              @unique
  avatar_oauth      String?
  avatar            image?              @relation(fields: [avatar_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_participant event_participant[]
  changes           change[]

  @@index([avatar_id])
}


model tag {
  id         String      @id @default(uuid())
  name       String      @unique
  created_at DateTime?   @default(now())
  updated_at DateTime?   @updatedAt
  game_tag   game_tag[]
  tag_alias  tag_alias[]
}

/// A variant spelling of a tag (#207): entering it attaches the tag instead.
model tag_alias {
  alias      String    @id
  tag_id     String   
  created_at DateTime? @default(now())
  tag        tag       @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum operation_type {
  create
  update
  delete
}

enum entity_type {
  studio
  association
}

enum event_status {
  ongoing
  canceled
}

enum entity_status {
  active
  closed
  hiatus
}

enum game_entity_role {
  developer
  co_developer
  publisher
  porting
  support
}
